---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusPanel from '../components/StatusPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    slug: 'migracao-aws-oci',
    title: 'Migração de custos AWS → OCI',
    summary:
      'Análise formal de custos comparando provedores após uma migração, identificando redução estrutural via compute e rede, e um ponto de atenção específico em banco de dados gerenciado.',
    tags: ['FinOps', 'OCI', 'AWS'],
  },
  {
    slug: 'oke-multicluster-gitops',
    title: 'Multi-cluster OKE com GitOps',
    summary:
      'Arquitetura de múltiplos clusters Kubernetes (OKE) com entrega contínua via ArgoCD e Bitbucket Pipelines, incluindo padrões de troubleshooting e recuperação.',
    tags: ['Kubernetes', 'ArgoCD', 'CI/CD'],
  },
  {
    slug: 'pki-privada-cert-manager',
    title: 'PKI privada com cert-manager',
    summary:
      'Emissão automatizada de certificados internos usando uma CA privada na nuvem integrada ao cert-manager, com notas sobre distribuição de confiança.',
    tags: ['TLS', 'PKI', 'cert-manager'],
  },
  {
    slug: 'observabilidade-sla',
    title: 'Observabilidade e SLA de suporte',
    summary:
      'Integração de dados de helpdesk via API REST com Grafana para acompanhamento de SLA, com alertas encaminhados para ferramentas de acompanhamento de equipe.',
    tags: ['Grafana', 'Zabbix', 'SLA'],
  },
];
---

<BaseLayout title="Otávio — DevOps & Infraestrutura em Nuvem">
  <Header />
  <main id="conteudo" class="mx-auto max-w-4xl px-6 py-16">
    <section class="grid gap-10 sm:grid-cols-[1.1fr,1fr] sm:items-center">
      <div>
        <p class="font-mono text-sm text-accent-bright">DevOps · Infraestrutura em nuvem</p>
        <h1 class="mt-3 text-3xl font-semibold leading-tight text-text sm:text-4xl">
          Construo e mantenho a infraestrutura por trás dos sistemas — <br
            class="hidden sm:block"
          />
          e este site é prova disso.
        </h1>
        <p class="mt-4 text-muted">
          Kubernetes multi-cluster, GitOps, redes seguras e observabilidade. Abaixo, casos reais de
          arquitetura, diagnóstico e decisão técnica.
        </p>
      </div>
      <StatusPanel />
    </section>

    <section id="projetos" class="mt-20">
      <h2 class="font-mono text-sm uppercase tracking-wide text-muted">Casos de estudo</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {projects.map((p) => <ProjectCard {...p} />)}
      </div>
    </section>

    <section id="sobre" class="mt-20 border-t border-border pt-12">
      <h2 class="font-mono text-sm uppercase tracking-wide text-muted">Sobre</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Atuo com DevOps e infraestrutura, gerenciando ambientes Kubernetes multi-cluster (OKE),
        pipelines de CI/CD e a stack de rede, TLS e observabilidade que sustenta esses ambientes.
        Atualmente também curso pós-graduação em Cibersegurança.
      </p>
    </section>
  </main>
  <footer class="border-t border-border py-8 text-center font-mono text-xs text-muted">
    build: <a href="https://github.com/otaviohc19/otaviorodrigues/actions" class="hover:text-text"
      >pipeline</a
    >
    · código-fonte: <a href="https://github.com/otaviohc19/otaviorodrigues" class="hover:text-text"
      >github</a
    >
  </footer>
</BaseLayout>
