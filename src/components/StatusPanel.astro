---
import TerminalWindow from './TerminalWindow.astro';

interface Service {
  name: string;
  detail: string;
  status: 'operational' | 'monitoring';
}

const services: Service[] = [
  { name: 'kubernetes-gitops', detail: 'OKE multi-cluster · ArgoCD', status: 'operational' },
  { name: 'networking-vpn', detail: 'WireGuard · NSG · roteamento', status: 'operational' },
  { name: 'pki-tls', detail: 'cert-manager · CA privada', status: 'operational' },
  { name: 'observability', detail: 'Zabbix · Grafana · SLA', status: 'operational' },
];
---

<TerminalWindow title="status.sh" class="font-mono text-sm">
  <ul class="divide-y divide-border" role="group" aria-label="Áreas de atuação">
    {
      services.map((s) => (
        <li class="flex items-center justify-between px-4 py-3">
          <div class="flex items-center gap-3">
            <span
              class:list={[
                'h-2 w-2 rounded-full',
                s.status === 'operational' ? 'status-dot bg-ok text-ok' : 'bg-status',
              ]}
              aria-hidden="true"
            />
            <span class="text-text">{s.name}</span>
          </div>
          <span class="text-muted text-xs sm:text-sm">{s.detail}</span>
        </li>
      ))
    }
  </ul>
</TerminalWindow>
