---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const relative = path.startsWith(base) ? path.slice(base.length) : path;
const isEnglish = relative === 'en' || relative.startsWith('en/');
const withoutLangPrefix = isEnglish ? relative.replace(/^en\/?/, '') : relative;

const homeHref = isEnglish ? `${base}en/` : base;
const langPrefix = isEnglish ? `${base}en/` : base;
const otherLangHref = isEnglish ? `${base}${withoutLangPrefix}` : `${base}en/${withoutLangPrefix}`;
const otherLangLabel = isEnglish ? '🇧🇷' : '🇺🇸';

const t = isEnglish
  ? { projects: 'projects', stack: 'stack', about: 'about', contact: 'contact' }
  : { projects: 'projetos', stack: 'stack', about: 'sobre', contact: 'contato' };

const links = [
  { href: `${langPrefix}#projetos`, label: t.projects, external: false },
  { href: `${langPrefix}#stack`, label: t.stack, external: false },
  { href: `${langPrefix}#sobre`, label: t.about, external: false },
  { href: `${langPrefix}#contato`, label: t.contact, external: false },
  { href: 'https://github.com/otaviohc19', label: 'github', external: true },
  { href: 'https://www.linkedin.com/in/otaviohcardoso/', label: 'linkedin', external: true },
];
---

<header class="border-b border-border/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4 sm:py-5">
    <a
      href={homeHref}
      class="font-mono text-sm text-text transition-colors hover:text-accent-bright"
    >
      ~/otavio<span class="text-accent-bright">$</span>
    </a>

    <!-- Nav desktop -->
    <ul class="hidden items-center gap-6 font-mono text-sm sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.external ? 'me' : undefined}
              target={link.external ? '_blank' : undefined}
              class="text-muted decoration-accent-bright/70 underline-offset-4 transition-colors hover:text-text hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={otherLangHref}
          class="rounded border border-border px-2 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent-bright"
          aria-label={isEnglish ? 'Mudar para português' : 'Switch to English'}
        >
          {otherLangLabel}
        </a>
      </li>
    </ul>

    <!-- Botão hambúrguer (só mobile) -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menu"
      class="-mr-2 flex h-10 w-10 items-center justify-center text-text sm:hidden"
    >
      <svg
        id="icon-open"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="h-5 w-5"
      >
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="hidden h-5 w-5"
      >
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </nav>

  <!-- Nav mobile (colapsável) -->
  <ul
    id="mobile-nav"
    class="hidden flex-col gap-1 border-t border-border/80 px-6 py-3 font-mono text-sm sm:hidden"
  >
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.external ? 'me' : undefined}
            target={link.external ? '_blank' : undefined}
            class="block rounded px-2 py-2.5 text-muted transition-colors hover:bg-surface hover:text-text"
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href={otherLangHref}
        class="block rounded px-2 py-2.5 text-muted transition-colors hover:bg-surface hover:text-text"
      >
        {otherLangLabel === 'EN' ? '🇺🇸 English' : '🇧🇷 Português'}
      </a>
    </li>
  </ul>
</header>

<script src={`${base}nav.js`} defer></script>
