---
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-border/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5">
    <a href={base} class="font-mono text-sm text-text transition-colors hover:text-accent-bright">
      ~/otavio<span class="text-accent-bright">$</span>
    </a>
    <ul class="flex gap-6 font-mono text-sm">
      <li>
        <a
          href={`${base}#projetos`}
          class="text-muted decoration-accent-bright/70 underline-offset-4 transition-colors hover:text-text hover:underline"
        >
          projetos
        </a>
      </li>
      <li>
        <a
          href={`${base}#sobre`}
          class="text-muted decoration-accent-bright/70 underline-offset-4 transition-colors hover:text-text hover:underline"
        >
          sobre
        </a>
      </li>
      <li>
        <a
          href="https://github.com/otaviohc19"
          class="text-muted decoration-accent-bright/70 underline-offset-4 transition-colors hover:text-text hover:underline"
          rel="me"
        >
          github
        </a>
      </li>
    </ul>
  </nav>
</header>
