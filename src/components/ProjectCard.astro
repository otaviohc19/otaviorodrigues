---
type Domain = 'kubernetes' | 'network' | 'security' | 'observability' | 'cloud';

interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  caseId: string;
  domain: Domain;
}

const { slug, title, summary, tags, caseId, domain } = Astro.props;
const base = import.meta.env.BASE_URL;

const domainStyles: Record<Domain, { bar: string; hoverText: string; tag: string }> = {
  cloud: { bar: 'bg-rose', hoverText: 'group-hover:text-rose', tag: 'text-rose' },
  kubernetes: {
    bar: 'bg-accent',
    hoverText: 'group-hover:text-accent-bright',
    tag: 'text-accent-bright',
  },
  network: { bar: 'bg-teal', hoverText: 'group-hover:text-teal', tag: 'text-teal' },
  security: { bar: 'bg-status', hoverText: 'group-hover:text-status', tag: 'text-status' },
  observability: { bar: 'bg-ok', hoverText: 'group-hover:text-ok', tag: 'text-ok' },
};

const style = domainStyles[domain];
---

<a
  href={`${base}projects/${slug}/`}
  class="group relative block overflow-hidden rounded-lg border border-border bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-border hover:bg-surface-hover hover:shadow-lg hover:shadow-black/30"
>
  <span class:list={['absolute inset-y-0 left-0 w-0.5', style.bar]} aria-hidden="true"></span>
  <p class="font-mono text-xs tracking-wide text-muted/80">case://{caseId}</p>
  <h3 class:list={['mt-2 font-mono text-base text-text transition-colors', style.hoverText]}>
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <li class:list={['rounded border border-border px-2 py-0.5 font-mono text-xs', style.tag]}>
          {tag}
        </li>
      ))
    }
  </ul>
  <p
    class:list={[
      'mt-4 flex items-center gap-1 font-mono text-xs text-muted/70 transition-colors',
      style.hoverText,
    ]}
  >
    ver caso completo
    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </p>
</a>
