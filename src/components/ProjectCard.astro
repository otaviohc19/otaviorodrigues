---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
}

const { slug, title, summary, tags } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}projects/${slug}/`}
  class="group block rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent hover:bg-surface-hover"
>
  <h3 class="font-mono text-base text-text group-hover:text-accent-bright">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <li class="rounded border border-border px-2 py-0.5 font-mono text-xs text-muted">{tag}</li>
      ))
    }
  </ul>
</a>
