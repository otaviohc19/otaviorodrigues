---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <button
    type="button"
    class="lightbox-trigger block w-full cursor-zoom-in overflow-hidden rounded-lg border border-border transition-opacity hover:opacity-90"
    aria-label={`Ampliar imagem: ${alt}`}
  >
    <Image src={src} alt={alt} width={800} quality={80} format="webp" />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
