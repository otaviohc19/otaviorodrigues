---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

type Domain = 'kubernetes' | 'network' | 'security' | 'observability' | 'cloud';

interface Props {
  title: string;
  description: string;
  domain: Domain;
  caseId: string;
}

const { title, description, domain, caseId } = Astro.props;
const base = import.meta.env.BASE_URL;

const domainText: Record<Domain, string> = {
  cloud: 'text-rose',
  kubernetes: 'text-accent-bright',
  network: 'text-teal',
  security: 'text-status',
  observability: 'text-ok',
};

const domainH2: Record<Domain, string> = {
  cloud: '[&_h2]:text-rose',
  kubernetes: '[&_h2]:text-accent-bright',
  network: '[&_h2]:text-teal',
  security: '[&_h2]:text-status',
  observability: '[&_h2]:text-ok',
};

const accent = domainText[domain];
---

<BaseLayout title={`${title} — Otávio`} description={description}>
  <Header />
  <main id="conteudo" class="mx-auto max-w-2xl px-6 py-16">
    <a href={`${base}#projetos`} class="font-mono text-xs text-muted hover:text-text">
      &larr; voltar aos casos de estudo
    </a>
    <p class:list={['mt-6 font-mono text-xs tracking-wide', accent]}>case://{caseId}</p>
    <h1 class="mt-2 text-2xl font-semibold text-text sm:text-3xl">{title}</h1>
    <div
      class:list={[
        'prose-invert mt-8 space-y-6 text-muted',
        '[&_h2]:mt-10 [&_h2]:font-mono [&_h2]:text-sm [&_h2]:uppercase [&_h2]:tracking-wide',
        domainH2[domain],
        '[&_p]:leading-relaxed [&_li]:leading-relaxed [&_strong]:text-text',
        '[&_figure]:mt-6 [&_figcaption]:mt-2 [&_figcaption]:font-mono [&_figcaption]:text-xs [&_figcaption]:text-muted/70',
      ]}
    >
      <slot />
    </div>
  </main>
</BaseLayout>
