---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${title} — Otávio`} description={description}>
  <Header />
  <main id="conteudo" class="mx-auto max-w-2xl px-6 py-16">
    <a href={`${base}#projetos`} class="font-mono text-xs text-muted hover:text-text">
      &larr; voltar aos casos de estudo
    </a>
    <h1 class="mt-6 text-2xl font-semibold text-text sm:text-3xl">{title}</h1>
    <div
      class="prose-invert mt-8 space-y-6 text-muted [&_h2]:mt-10 [&_h2]:font-mono [&_h2]:text-sm [&_h2]:uppercase [&_h2]:tracking-wide [&_h2]:text-accent-bright [&_p]:leading-relaxed [&_li]:leading-relaxed [&_strong]:text-text"
    >
      <slot />
    </div>
  </main>
</BaseLayout>
