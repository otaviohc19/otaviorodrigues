---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfólio técnico — DevOps, Kubernetes, infraestrutura em nuvem e segurança.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const relative = path.startsWith(base) ? path.slice(base.length) : path;
const isEnglish = relative === 'en' || relative.startsWith('en/');
const withoutLangPrefix = isEnglish ? relative.replace(/^en\/?/, '') : relative;

const htmlLang = isEnglish ? 'en' : 'pt-BR';
const ptHref = `${base}${withoutLangPrefix}`;
const enHref = `${base}en/${withoutLangPrefix}`;
const skipLinkLabel = isEnglish ? 'Skip to content' : 'Ir para o conteúdo';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="pt-BR" href={ptHref} />
    <link rel="alternate" hreflang="en" href={enHref} />

    <!--
      CSP via meta tag: opção disponível no GitHub Pages, já que não há
      controle sobre headers HTTP do servidor. Limitação conhecida: diretivas
      como frame-ancestors não funcionam via meta tag (só via header real).
      Documentado em SECURITY.md.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-bg focus:rounded"
    >
      {skipLinkLabel}
    </a>
    <slot />
  </body>
</html>
